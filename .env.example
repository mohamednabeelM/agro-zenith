# ─────────────────────────────────────────────────────────────
#  Agro Zenith — Environment Variables
#  Copy this file → .env  (never commit .env to git)
# ─────────────────────────────────────────────────────────────

# ── OpenWeatherMap API (Free tier works fine) ─────────────────
# Get your key at: https://openweathermap.org/api
# Used in: Dashboard weather widget, FarmMap field conditions
REACT_APP_WEATHER_API_KEY=your_openweathermap_key_here

# ── Agmarknet / data.gov.in API (Free government API) ─────────
# Register at: https://data.gov.in/catalog/current-daily-price-various-commodities
# Used in: MarketPrices page (falls back to static data if missing)
REACT_APP_AGMARKNET_KEY=your_data_gov_in_api_key_here

# ── Google Maps API (Optional — for Shops directions) ─────────
# Get key at: https://console.cloud.google.com/
# Used in: Shops page "Get Directions" button
REACT_APP_GOOGLE_MAPS_KEY=your_google_maps_key_here

# ─────────────────────────────────────────────────────────────
#  NOTE: The app works fully WITHOUT any keys above.
#  All pages fall back to rich static/mock data automatically.
#  The AI features (AgroBot + Disease Detection) use the
#  Anthropic API — handled server-side, no key needed here.
#  If you want direct browser proxy mode, add this key below.
REACT_APP_ANTHROPIC_KEY=your_anthropic_api_key_here
# ─────────────────────────────────────────────────────────────